+def merge_history(*groups) -> list[dict]:
+    """点の和集合。同じ計画点が二重に来たら開映に近い読みを残す。"""
+    best: dict[Any, dict] = {}
+    for group in groups:
+        for h in group or []:
+            if not h or h.get("sold") is None:
+                continue
+            key = h.get("slot")
+            if key is None:
+                key = round(h.get("lead") or 0)
+            cur = best.get(key)
+            if cur is None or _hist_rank(h) > _hist_rank(cur):
+                best[key] = h
+    # 開映から遠い点（＝早い時刻に撮ったもの）を先頭に置く。lead が欠けている
