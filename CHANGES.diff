+        return 0
+    counts = rec.get("seat_counts") or {}
+    total = counts.get("total") or 0
+    if total <= 0 or rec.get("occupancy") is None:
+        return 1                       # 座席が 1 つも読めていない
+    expected = counts.get("expected")
