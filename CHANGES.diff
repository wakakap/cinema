+    # なるが、あちらは「不明なら既存を押しのけない」で、こちらは「不明なら
+    # 推移の途中に割り込ませない」。どちらも安全側に倒している。
+    return sorted(best.values(), key=lambda h: -lead_of(h, -1.0))
